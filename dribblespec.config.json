{
  "mod": "Mod Configuration Menu/Mods/BG3MCM",
  "contexts": [
    "server",
    "client"
  ],
  "exclude": [
    "**/DribbleSpec/**",
    "**/Tests/**",
    "Lib/**"
  ],
  "coverage": {
    "include": [
      "**/*.lua"
    ]
  },
  "mutation": {
    "ignoreCalls": [
      "MCMPrint",
      "MCMWarn",
      "MCMDebug",
      "MCMSuccess"
    ],
    "groups": {
      "validators": {
        "files": [
          "Shared/Helpers/Validators/CheckboxValidator.lua",
          "Shared/Helpers/Validators/ColorValidator.lua",
          "Shared/Helpers/Validators/DragFloatValidator.lua",
          "Shared/Helpers/Validators/DragIntValidator.lua",
          "Shared/Helpers/Validators/EnumValidator.lua",
          "Shared/Helpers/Validators/EventButtonValidator.lua",
          "Shared/Helpers/Validators/FloatUtils.lua",
          "Shared/Helpers/Validators/FloatValidator.lua",
          "Shared/Helpers/Validators/IntValidator.lua",
          "Shared/Helpers/Validators/KeybindingV2Validator.lua",
          "Shared/Helpers/Validators/ListV2Validator.lua",
          "Shared/Helpers/Validators/RadioValidator.lua",
          "Shared/Helpers/Validators/SliderFloatValidator.lua",
          "Shared/Helpers/Validators/SliderIntValidator.lua",
          "Shared/Helpers/Validators/TextValidator.lua",
          "Shared/Helpers/PathValidator.lua"
        ],
        "testFilter": {
          "tags": [
            "validators"
          ]
        }
      },
      "blueprint": {
        "files": [
          "Shared/Helpers/Blueprint/BlueprintCache.lua",
          "Shared/Classes/JsonLayer.lua",
          "Shared/Classes/ModConfig.lua"
        ],
        "testFilter": {
          "tags": [
            "blueprint"
          ]
        }
      },
      "preprocessing": {
        "files": [
          "Shared/Helpers/Preprocessing/DataPreprocessing.lua",
          "Shared/Helpers/Preprocessing/LoadedSettingsRepair.lua"
        ],
        "testFilter": {
          "tags": [
            "preprocessing"
          ]
        }
      },
      "store": {
        "files": [
          "Shared/DynamicSettings/Services/StorageSyncService.lua",
          "Shared/DynamicSettings/Services/SettingsService.lua",
          "Shared/DynamicSettings/Adapters/JsonAdapter.lua"
        ],
        "testFilter": {
          "tags": [
            "store"
          ]
        }
      },
      "keybindings": {
        "files": [
          "Shared/Helpers/Keybindings/KeybindingManager.lua",
          "Shared/Helpers/Keybindings/KeyPresentationMapping.lua",
          "Shared/Helpers/Keybindings/SDLKeys.lua",
          "Client/Helpers/Keybindings/KeybindingCaptureSession.lua",
          "Client/Helpers/Keybindings/KeybindingsRegistry.lua",
          "Client/Helpers/Keybindings/InputCallbackManager.lua"
        ],
        "testFilter": {
          "tags": [
            "keybinding_v2"
          ]
        }
      },
      "mcmapi": {
        "files": [
          "Shared/Helpers/MCM/GlobalTable/TableInjector.lua",
          "Shared/Helpers/MCM/GlobalTable/InternalAPIGuard.lua",
          "Shared/Helpers/MCM/GlobalTable/MCMAPIMethods.lua",
          "Shared/Helpers/MCM/GlobalTable/MCMAPIUtils.lua",
          "Shared/Helpers/MCM/GlobalTable/MetatableInjection.lua",
          "Shared/Helpers/MCM/GlobalTable/MCMAPIImplementations.lua"
        ],
        "testFilter": {
          "tags": [
            "mcmapi"
          ]
        }
      },
      "visibility": {
        "files": [
          "Client/Helpers/VisibilityManager/VisibilityManager.lua"
        ],
        "testFilter": {
          "tags": [
            "visibility"
          ]
        }
      },
      "blueprint-shape": {
        "files": [
          "Shared/Helpers/Blueprint/BlueprintShape.lua"
        ],
        "testFilter": {
          "tags": [
            "blueprint-shape"
          ]
        }
      },
      "enum-choices": {
        "files": [
          "Shared/Helpers/MCM/EnumChoicesHelper.lua"
        ],
        "testFilter": {
          "tags": [
            "enum-choices"
          ]
        }
      },
      "config-definition": {
        "files": [
          "Shared/Classes/ConfigDefinition/Setting.lua",
          "Shared/Classes/ConfigDefinition/Section.lua",
          "Shared/Classes/ConfigDefinition/Tab.lua",
          "Shared/Classes/ConfigDefinition/Blueprint.lua"
        ],
        "testFilter": {
          "tags": [
            "config-definition"
          ]
        }
      }
    }
  }
}
